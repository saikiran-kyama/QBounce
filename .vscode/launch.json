  "version": "0.2.0",
  "configurations": [
    {
      "name": "QBounce Service (Dev)",
      "type": "java",
      "request": "launch",
      "mainClass": "com.qbounce.QBounceApplication",
      "projectName": "qbounce-service",
      "env": {
        "SPRING_PROFILES_ACTIVE": "dev"
      },
      "vmArgs": "-Dspring.profiles.active=dev"
    },
    {
      "name": "Current File",
      "type": "java",
      "request": "launch",
      "mainClass": "${file}"
    }
  ]
}
